# ==============================================
# SHAKTI YATRA - Environment Configuration
# ==============================================

# Backend
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=shakti-yatra-super-secret-key-change-in-production-2026

# Database
# Default is SQLite for instant plug-and-play local development
DATABASE_URL=sqlite:///./shakti_yatra.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shakti_yatra

# AI Assistant
# Optional OpenAI / Gemini API key for dynamic LLM responses
# Falls back seamlessly to built-in verified knowledge grounding engine
GEMINI_API_KEY=
OPENAI_API_KEY=

# Maps
# Optional Mapbox or Google Maps public key for vector tiles
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_API_URL=http://localhost:8000/api
